+def remote_size(url: str) -> int | None:
+    """远端文件真实字节数（HF 的 302 带 X-Linked-Size，否则取最后一跳 Content-Length）。"""
+    try:
+        out = subprocess.run(["curl", "-sIL", "--max-time", "30", url], capture_output=True, text=True).stdout
+    except Exception:
+        return None
+    linked, length = None, None
+    for line in out.splitlines():
+        k, _, v = line.partition(":")
+        k = k.strip().lower()
+        if k == "x-linked-size" and v.strip().isdigit():
+            linked = int(v.strip())
+        elif k == "content-length" and v.strip().isdigit():
+            length = int(v.strip())
+    return linked or length
+
+
+def disk_report() -> str:
+    return subprocess.run("df -h /tmp | tail -1", shell=True, capture_output=True, text=True).stdout.strip()
+
